CompileFlags:
  CompilationDatabase: "."
  Compiler: "g++"
  
  Add: [
    "-I./godot-cpp/include",
    "-I./godot-cpp/gen/include",
    "-I./godot-cpp/gdextension",
    "-I./src",
    "-DGDEXTENSION",
    "-DLINUX_ENABLED",
    "-DDEBUG_ENABLED",
    "-isystem"
  ]
  
  Remove: [ "-fno-gnu-unique", "-fstack-usage", "-m*" ]

Index:
  Background: Build
