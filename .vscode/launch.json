{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach GDExtension (Linux)",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/.godot_bin",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
        }
    ]
}